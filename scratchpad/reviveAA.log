                <div style={{ fontSize: 10, letterSpacing: 0.4, textTransform: \"uppercase\", color: \"#c9a55c\", fontWeight: 800, marginBottom: 8 }}>
                  Steward Rules · {permission.verdict}
                </div>
                <div style={{ fontSize: 13, color: \"#ede6d3\", lineHeight: 1.5 }}>
                  {permission.headline}
