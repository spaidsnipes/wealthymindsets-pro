# WM PRO — Environment Variable Template
# ---------------------------------------------------------------
# Every variable below is READ BY THE CURRENT CODE. Names verified via
#   grep -rhoE "process\.env\.[A-Z][A-Z0-9_]+" src/ | sort -u
# on 2026-08-23. If you add or rename a process.env.* reference,
# update this file in the same commit.
#
# THIS FILE STORES NAMES ONLY — never values. Copy this file to
# `.env.local` for local dev and paste your real values there.
# `.env.local` is git-ignored.
#
# Cloudflare / Vercel / any-host installers should treat every
# variable below as REQUIRED unless explicitly marked OPTIONAL.

# ============================================================
# PUBLIC (safe for client bundle)
# ============================================================
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# Supabase — public identity + publishable key (server also reads the
# service-role key below, which must never appear in the client bundle).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# LiveKit realtime — the wss host. NO LONGER read by the browser: since
# 2026-09-21 /api/livekit returns the host WITH the minted token, because a
# NEXT_PUBLIC_ value is inlined at BUILD time and WM Pro builds locally then
# deploys to Cloudflare — so a host set only as a Cloudflare secret inlined as
# `undefined` and the room could never open, no matter how many redeploys.
# Prefer LIVEKIT_URL (below, in the server block) for a Cloudflare deployment;
# this name still resolves and is kept for local .env.local setups.
NEXT_PUBLIC_LIVEKIT_URL=

# Market data — public keys (rate-limited, provider-safe by design).
NEXT_PUBLIC_FINNHUB_KEY=
NEXT_PUBLIC_FMP_KEY=
NEXT_PUBLIC_POLYGON_KEY=

# Optional broker proxy URL for the paper/live Alpaca path.
NEXT_PUBLIC_ALPACA_PROXY_URL=
LONGBRIDGE_BRIDGE_URL=
LONGBRIDGE_BRIDGE_TOKEN=
LONGBRIDGE_CANARY_SYMBOL=

# Dreamboard (Above The Hill) external app URL — set to its Cloudflare host.
NEXT_PUBLIC_DREAMBOARD_URL=

# ============================================================
# SERVER-ONLY SECRETS — NEVER in the client bundle
# ============================================================

# Supabase server role — full-access; keep server-only.
SUPABASE_SERVICE_ROLE_KEY=

# App-wide JWT signing/verification.
JWT_SECRET=

# Shared position authority (§11 / H16). A session cookie proves a HUMAN is
# signed in; it does NOT prove the caller is the reconciliation worker. Only a
# request carrying this value in `x-wm-reconciliation-worker` may write settled
# broker truth (filled/protected quantity, execution + protection state) to
# wm_decision.positions — everyone else writes intent.
# UNSET IS SAFE AND FAILS CLOSED: with no secret configured, no caller can
# claim the reconciliation role, so the authority accepts intent only.
WM_RECONCILIATION_WORKER_SECRET=

# Alpaca — paper + live. Canonical names are preferred. The two legacy
# brokerage names are accepted as one complete live pair for the existing
# Cloudflare installation; never mix one canonical half with one legacy half.
ALPACA_KEY=
ALPACA_SECRET=
ALPACA_BROKERAGE_KEY=
ALPACA_BROKERAGE_KEY_SECRET_=
ALPACA_CANARY_SYMBOL=
ALPACA_PAPER_KEY=
ALPACA_PAPER_SECRET=
# The pair the production host actually carries. Accepted as a COMPLETE
# alternative set (resolveAlpacaPaperCredentials) — set BOTH or neither; the
# canonical pair above wins when both sets are present.
ALPACA_PAPER_TRADE_API_KEY=
ALPACA_PAPER_TRADE_SECRET_KEY=
ALPACA_OWNER_USER_ID=

# Tastytrade — OAuth-style (client id + secret + refresh token).
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_ENV=

# Webull — legacy client/bridge names plus the signed, read-only Data API.
# API_KEY/API_SECRET stay server-only. API_HOST and CANARY_SYMBOL are optional
# overrides (production defaults: api.webull.com and TSLA).
WEBULL_CLIENT_ID=
WEBULL_DATA_URL=
# Canonical Webull OpenAPI names. WEBULL_API_* remains a temporary alias.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_API_KEY=
WEBULL_API_SECRET=
WEBULL_ACCESS_TOKEN=
WEBULL_API_HOST=
WEBULL_CANARY_SYMBOL=

# moomoo (Futu) — OpenD bridge for the read-only market-data adapter.
# BRIDGE_URL/TOKEN reach the local OpenD gateway; CANARY_SYMBOL is the
# health-probe instrument. Server-only; never exposed to the browser.
MOOMOO_BRIDGE_URL=
MOOMOO_BRIDGE_TOKEN=
MOOMOO_CANARY_SYMBOL=

# Market data — server keys (higher rate limits than NEXT_PUBLIC_* variants).
FINNHUB_KEY=
# FINNHUB_KEY_ (trailing underscore) is the name the production Cloudflare host
# actually carries. It is DECLARED as an alias in providerReadiness.ts and read
# by resolveProviderEnv, so the tape runs without a dashboard rename. Prefer the
# canonical name above for new setups; the canonical name wins when both exist.
FINNHUB_KEY_=
FMP_KEY=
POLYGON_KEY=

# LiveKit — server API key + secret, plus the wss host the room is dialled on.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# The wss host, resolved SERVER-side at runtime and returned with the token.
# Prefer this name over NEXT_PUBLIC_LIVEKIT_URL on Cloudflare — it is read at
# runtime, so setting it as a secret is sufficient. The canonical name still
# wins when both are present.
LIVEKIT_URL=
# The names this Cloudflare host actually carries — the same trailing-underscore
# bulk-load artifact as FINNHUB_KEY_ above. DECLARED as livekit aliases in
# providerReadiness.ts and read by BOTH /api/livekit and /api/livekit/approve
# through resolveProviderEnv, so the receipt and the wire move together.
# CAVEAT, recorded rather than hidden: `ATH_` is the sibling product's
# namespace, so this pair may belong to a DIFFERENT LiveKit project. Presence
# cannot settle that — only opening a room can. Accepting them makes the lane
# attemptable and turns an invisible name mismatch into a visible 401.
ATH_LIVEKIT_KEY_=
ATH_LIVEKIT_KEY_SECRET_=

# Gemini — AI provider (spaidbot route).
GEMINI_API_KEY=

# Resend — transactional email.
# RESEND_API_KEY_ (trailing underscore) is the name the production Cloudflare
# host actually carries — MEASURED 2026-09-21 by reading the Worker's own
# Settings → Variables and secrets list. Same bulk-load artifact as
# FINNHUB_KEY_. It is DECLARED as an alias in PLATFORM_SECRETS and read by
# email.ts through resolveProviderEnv, so signup/reset mail sends without a
# dashboard rename. The canonical name wins when both exist.
RESEND_API_KEY=
RESEND_API_KEY_=
# NOT SET on the production host (measured 2026-09-21). Until it is, email.ts
# falls back to onboarding@resend.dev, which Resend TEST MODE delivers ONLY to
# the Resend account owner — so real users still get no mail even now that the
# key resolves. Set this to a verified-domain sender to finish the lane.
RESEND_FROM_EMAIL=

# Build stamp — NOT a host variable. Do not set these on Cloudflare.
#
# These are set by the `build:*` npm scripts in the BUILD shell, from
# `git rev-parse HEAD`, and inlined into the bundle by `next.config.ts`.
# Setting them on a host would let a running worker claim a commit it was
# not built from — the one lie this pair exists to make impossible. Left
# empty here, the build-identity receipt reports UNSTAMPED, which is the
# correct answer for a bundle produced outside the build scripts.
# See src/lib/buildIdentity.ts.
WM_BUILD_SHA=
WM_BUILD_TIME=

# ============================================================
# CODE ↔ REGISTRY RECONCILIATION NOTES (per Hosting Runbook §5.6)
# ============================================================
# The Founder's Master Environment Variable Registry (Drive doc
# id 11zwTPRT_jSF41V4TrxAFCBYV8Kql9regdbdrX-QTPHU) documents some
# variables under DIFFERENT names than the running code reads. Before
# Cloudflare cutover, resolve each row:
#
#   Registry name                     Code name          Action
#   ------------------------------------------------------------------
#   ALPACA_PAPER_TRADE_API_KEY        ALPACA_PAPER_KEY   RESOLVED 2026-09-11
#   ALPACA_PAPER_TRADE_SECRET_KEY     ALPACA_PAPER_SECRET  RESOLVED 2026-09-11
#   FINNHUB_KEY_                      FINNHUB_KEY        RESOLVED 2026-09-11
#   POLYGON_API_KEY                   POLYGON_KEY        STILL ABSENT — see below
#   WEBULL_API_KEY / _SECRET          WEBULL_APP_KEY / _SECRET  ✓ aliased, READY
#   ATH_LIVEKIT_KEY_ / _SECRET_       LIVEKIT_API_KEY / _SECRET  RESOLVED 2026-09-21
#   TWELVE_DATA_KEY_                  (not referenced)   Retire from host OR add code
#   BIGDATA_API_KEY                   (not referenced)   Retire from registry OR add code
#   RESEND_FROM_EMAIL                 RESEND_FROM_EMAIL  ✓ match
#
# WHAT ACTUALLY HAPPENED (2026-09-11). This table said "resolve each row
# BEFORE Cloudflare cutover." The cutover happened; the rows did not get
# resolved; and the drift silently took real capability off the air —
# most expensively `FINNHUB_KEY_`, one trailing underscore, which kept the
# real-time US equity tape dark for six days while the secret sat present
# on the host. A reconciliation plan that lives only in a comment is not a
# reconciliation. Rows now resolve by DECLARATION in
# providerReadiness.ts (PROVIDER_REQUIREMENTS.aliases /
# .alternativeGroups), which resolveProviderEnv and the alpaca pair
# resolvers actually read — so a declared row connects the provider
# instead of merely describing it.
#
# STILL OPEN, and not fixable from the repo:
#   POLYGON_KEY  — absent under every accepted name AND no lookalike is
#                  present on the host. Genuinely unset. /api/symbol-search
#                  returns nothing until an owner sets it.
#   LIVEKIT      — the KEY PAIR is now resolved (2026-09-21): the aliases are
#                  declared AND both server routes read them through
#                  resolveProviderEnv, so the receipt and the wire moved
#                  together, which is what the old note was holding out for.
#                  WHAT IS STILL ABSENT: the wss host. No lookalike for it is
#                  present on the host under ANY accepted name — it is
#                  genuinely unset, not misspelled. Set LIVEKIT_URL as a
#                  Cloudflare secret and the Lounge lane is complete.
#                  NOT PROVED EITHER WAY: whether the ATH_-prefixed pair
#                  belongs to THIS product's LiveKit project. Presence-only
#                  checks cannot answer that; the first real room join will.
#
# Recommended policy: install the CODE names into Cloudflare (the
# code is the source of truth). Update the Drive registry to match
# the code names, and mark the old registry names TEMPORARY_ALIAS
# or RETIRE per Runbook §A.3.
#
# ============================================================
# MEASURED HOST INVENTORY — 2026-09-21
# ============================================================
# Read directly off the serving Worker (`wealthymindsets-pro`, PRODUCTION,
# account 3b685f46…5028) at Settings → Variables and secrets. NAMES ONLY.
# Bindings tab: EMPTY. This is not inference from a receipt; it is the list.
#
# Why this block exists: every previous entry in this file was reasoned from
# /api/broker/readiness, which is presence-only and — as the FINNHUB_KEY_
# episode proved — can be silent about a name it was never taught to look for.
# Two claims in this file were wrong until the list was actually read.
#
# THE 28 SECRETS PRESENT:
#   ALPACA_BROKERAGE_KEY            ALPACA_BROKERAGE_KEY_SECRET_
#   ALPACA_PAPER_TRADE_API_KEY      ALPACA_PAPER_TRADE_SECRET_KEY
#   ATH_LIVEKIT_KEY_                ATH_LIVEKIT_KEY_SECRET_
#   FINNHUB_KEY_                    FINNHUB_SECRET
#   GEMINI_API_KEY                  GEMINI_API_KEY_BOT_NUMBER_TWO_
#   GEMINI_ATHOS_AI_WORKERS         JWT_SECRET
#   NEW_ATH_SUPABASE_KEY_INFORMATION_{CLI_SETUP_COMMANDS,
#     DIRECT_CONNECTION_STRING, PROJECT_URL, PUBLISHABLE_KEY}
#   NEXT_PUBLIC_APP_URL             NEXT_PUBLIC_SITE_URL
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY   NEXT_PUBLIC_SUPABASE_URL
#   RESEND_API_KEY_                 SUPABASE_SECRET_KEY
#   TASTYTRADE_CLIENT_ID            TASTYTRADE_CLIENT_SECRET
#   TWELVE_DATA_KEY_                TWELVE_DATA_KEY_SECRET
#   WEBULL_API_KEY                  WEBULL_API_SECRET
#
# WHAT THE LIST SETTLED:
#   RESEND_API_KEY_   PRESENT, was UNREAD. Declared + wired 2026-09-21. This
#                     was a LIVE OUTAGE nobody had reported: every signup,
#                     reset and receipt email returned "RESEND_API_KEY missing"
#                     beside a working paid key. Resend is a PLATFORM secret,
#                     so the provider-row near-miss detector never scanned it.
#   LIVEKIT_URL       CONFIRMED ABSENT. No wss host under ANY name. The key
#                     pair (ATH_LIVEKIT_KEY_*) is present and now read. The
#                     Lounge needs exactly one more secret.
#   TASTYTRADE_REFRESH_TOKEN
#                     CONFIRMED ABSENT — not misspelled, not aliased, not on
#                     the Bindings tab, not a TASTY_TRADE_* variant. The host
#                     carries CLIENT_ID + CLIENT_SECRET only. The refresh-token
#                     grant in src/lib/tastytrade.ts cannot mint an access
#                     token without it, so this lane is genuinely unconfigured
#                     rather than misconfigured. It is issued from
#                     my.tastytrade.com → OAuth Applications → Manage →
#                     Create Grant, and only the account owner can issue it.
#   WEBULL_ACCESS_TOKEN
#                     ABSENT from this Worker. WEBULL_API_KEY/_SECRET are
#                     present, so the signed Data API can authenticate, but any
#                     lane that expects a broker session token will not find
#                     one here. If a token was added earlier it did not land on
#                     this Worker's production environment.
#   POLYGON_KEY / FMP_KEY / RESEND_FROM_EMAIL / MOOMOO_* / LONGBRIDGE_*
#                     ABSENT under every accepted name. Genuinely unset.
#   SUPABASE_SECRET_KEY / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
#                     Present under their non-canonical names and ALREADY
#                     aliased in code (PLATFORM_SECRETS / SERVICE_KEY_VARS).
#                     No action — recorded so the next reader does not "fix"
#                     a row that is already closed.
#   TWELVE_DATA_KEY_ / TWELVE_DATA_KEY_SECRET / FINNHUB_SECRET /
#   GEMINI_API_KEY_BOT_NUMBER_TWO_ / GEMINI_ATHOS_AI_WORKERS /
#   NEW_ATH_SUPABASE_KEY_INFORMATION_*
#                     PRESENT but referenced by NO code in this repo. Either
#                     adopt them deliberately or retire them from the host;
#                     an unread secret is attack surface with no upside.
